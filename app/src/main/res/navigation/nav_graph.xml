<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.mobile.tugasrancangmoka.fragment.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_pos"
        android:name="com.mobile.tugasrancangmoka.fragment.POSFragment"
        android:label="POS"
        tools:layout="@layout/fragment_pos" />

    <fragment
        android:id="@+id/navigation_inventory"
        android:name="com.mobile.tugasrancangmoka.fragment.InventoryFragment"
        android:label="Inventory"
        tools:layout="@layout/fragment_inventory" />

    <fragment
        android:id="@+id/navigation_history"
        android:name="com.mobile.tugasrancangmoka.fragment.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/navigation_report"
        android:name="com.mobile.tugasrancangmoka.fragment.ReportFragment"
        android:label="History"
        tools:layout="@layout/fragment_report" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.mobile.tugasrancangmoka.fragment.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />


</navigation>
