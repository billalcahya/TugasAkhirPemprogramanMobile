<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_container_low"
    app:cardCornerRadius="@dimen/radius_md"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/layout_right_section"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/text_history_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TX-12345678"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_history_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="05 Jul 2026, 14:00"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_right_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end">

            <TextView
                android:id="@+id/text_history_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 25.000"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_history_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Completed"
                android:textColor="@color/on_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_completed"/>
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
