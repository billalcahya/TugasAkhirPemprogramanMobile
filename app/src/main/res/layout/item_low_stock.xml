<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp">

    <!-- Left Side: Product Info -->
    <LinearLayout
        android:id="@+id/layout_product_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_restock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textColor="@color/earth_dark_brown"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/text_stock_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Current Stock: 2 left"
            android:textColor="@color/red_strong"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Right Side: Restock Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_restock"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="Restock"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:paddingHorizontal="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/orange_strong"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
